# Ignore IDE and editor-specific files
.vscode/
.idea/
*.swp
*.bak
*~

# Ignore build output and temporary files
*.o
*.a
*.so
*.obj
*.exe
*.dll
*.lib
*.bin
tmp/
build/
dist/

# Ignore Go-specific build caches and modules
vendor/ # If you are not vendoring dependencies inside the container
go.work
go.work.sum

# Ignore documentation and markdown files (if not needed in the image)
*.md
docs/

# Ignore log files
*.log

# Exclude the Dockerfile itself and .dockerignore
Dockerfile
.dockerignore
